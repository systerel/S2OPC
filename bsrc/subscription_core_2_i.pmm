THEORY th_raf_fct IS

    band(binhyp(f: A +-> B),
    band(binhyp(dom(f) = A),
    band(binhyp(a <: A),
    band(binhyp(t <: B),
    band(binhyp(i: a),
    band(binhyp(j: a),
    band(binhyp(not(c: t)),
    band(binhyp(not(j = i)),
    band(binhyp(not(c: t)),
         binhyp(i: dom(f|>t)))))))))))
    =>
    {i}<<|(f|>t)<+{j|->(f|>t)(i)} = f<+{j|->f(i),i|->c}|>t
    ;

    band(binhyp(a : d +-> e),
    band(binhyp(dom(a) = d),
    band(binhyp(c : f +-> g),
    band(binhyp(f <: d),
    band(binhyp(b : d),
    band(binhyp(b : dom(c)),
         binhyp(c <: a)))))))
    =>
    a(b) = c(b)
    ;

    band(binhyp(a : d +-> e),
    band(binhyp(dom(a) = d),
    band(binhyp(c : f +-> e),
    band(binhyp(f <: d),
    band(binhyp(c <: a),
    band(binhyp(b : d),
         binhyp(b : dom(c))))))))
    =>
    a(b) = c(b)
    ;

    binhyp(a <: c)
    =>
    a <+ b <: c <+ b

END
&

THEORY th_eh_abs_var IS

   band(binhyp(b = c<|d$1|>e),
   band(bvrb(b),
        bnot(b\a))) &
   bguard((SUB ; RES) : bresult([b := c<|d$1|>e]a),f) &
   f
   =>
   a

END
&

THEORY th_smp IS

   (card(a) = 0) == (a = {})
   ;

   binhyp(c = 1..d) &
   blvar(e) &
   e\(c)
   =>
   (a<+{b|->0}|>c) == {b}<<|(a|>c)

END

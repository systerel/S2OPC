IMPLEMENTATION
    subscription_core_1_i

REFINES
    subscription_core_1

SEES
    constants,
    request_handle_bs,
    message_out_bs,
    message_in_bs,
    channel_mgr,
    constants_statuscodes_bs,
    subscription_core_bs

IMPORTS
    subscription_core_2,
    subscription_priority_sub_queue_bs,
    subscription_priority_sub_queue_it_bs

PROMOTES
    is_valid_subscription,
    is_valid_subscription_on_session,
    getall_session,
    get_card_session_seq_priority,
    get_card_session_seq_subscription,
    get_subscription_priority,
    get_subscription_publishInterval,
    set_subscription_publishInterval,
    set_subscription_timer_id,
    get_subscription_timer_id,
    set_subscription_state,
    get_subscription_state,
    set_subscription_MoreNotifications,
    get_subscription_MoreNotifications,
    set_subscription_MaxLifetimeAndKeepAliveCount,
    decrement_subscription_LifetimeCounter,
    reset_subscription_LifetimeCounter,
    get_subscription_LifetimeCounter,
    decrement_subscription_KeepAliveCounter,
    reset_subscription_KeepAliveCounter,
    get_subscription_KeepAliveCounter,
    set_subscription_MaxNotifsPerPublish,
    get_subscription_MaxNotifsPerPublish,
    set_subscription_MessageSent,
    get_subscription_MessageSent,
    set_subscription_PublishingEnabled,
    get_subscription_PublishingEnabled,
    set_subscription_SeqNum,
    get_subscription_SeqNum,
    reset_session_publishRequestQueue,
    set_session_publishRequestQueue,
    get_session_publishRequestQueue,
    get_subscription_notifRepublishQueue,
    get_subscription_monitoredItemQueue,
    log_subscription_transition,
    log_subscription_request_received,
    log_subscription_request_received_invalid_on_session,

    continue_iter_subscription_priority_queue

INVARIANT
    !session.(session : t_session => dom(a_session_seq_priority(session)) = 1..card(dom(a_session_seq_priority(session))) &
        dom(a_session_priority_subscriptions_queue(session)) = dom(a_session_seq_priority(session)))

OPERATIONS

    p_prio_sub_it <-- init_session_priority_subscriptions_iterator (p_session, p_prio_idx) =
    VAR
        l_prio_sub_q
    IN
        l_prio_sub_q <-- get_session_priority_subscriptions_queue (p_session, p_prio_idx);
        p_prio_sub_it <-- init_prio_subscriptions_queue_iterator (l_prio_sub_q)
    END
    ;

    p_prio_subs_queue, p_StatusCode_service <-- check_add_subscription (p_session, p_subscription, p_priority, p_isModifySub) =
    VAR
        l_nb_sub,
        l_prio_idx,
        l_nb_prio,
        l_sub_added_to_prio_q
    IN
        l_nb_sub <-- get_card_session_seq_subscription(p_session);
        l_prio_idx <-- get_session_priority_idx (p_session, p_priority);
        l_nb_prio <-- get_card_session_seq_priority(p_session);
        p_prio_subs_queue := c_prioritySubQueue_indet;
        l_sub_added_to_prio_q := FALSE;
        IF p_isModifySub = TRUE
        THEN
            l_nb_sub := l_nb_sub -1
        END;
        IF l_nb_sub = k_n_subscriptionPerSession_max or
           (l_prio_idx = 0 &
            l_nb_prio = k_n_subscriptionPerSession_max)
        THEN
            p_StatusCode_service := e_sc_bad_too_many_subscriptions
        ELSE
            IF l_prio_idx = 0
            THEN
                /* First subscription in this priority, allocate a new priority subscriptions queue for round robin */
                l_sub_added_to_prio_q, p_prio_subs_queue <-- allocate_new_prio_queue (p_subscription)
                /* DONE LATER: assigns the priority subscriptions queue as soon as the index is defined */
            ELSE
                /* Priority queue already exists */
                p_prio_subs_queue <-- get_session_priority_subscriptions_queue (p_session, l_prio_idx);
                l_sub_added_to_prio_q <-- add_subscription_to_prio_queue (p_prio_subs_queue, p_subscription)
            END
            ;
            IF l_sub_added_to_prio_q = TRUE
            THEN
                p_StatusCode_service := e_sc_ok
            ELSE
                p_StatusCode_service := e_sc_bad_out_of_memory
            END
        END
    END
    ;

    add_subscription
       (p_subscription,
        p_session,
        p_state,
        p_firstMsgSent,
        p_priority,
        p_revPublishInterval,
        p_revLifetimeCount,
        p_revKeepAliveCount,
        p_revMaxKeepAlive,
        p_maxNotificationsPerPublish,
        p_publishEnabled,
        p_seqNumInit,
        p_republishQueue,
        p_monitoredItemQueue,
        p_timerId,
        p_prio_subs_queue,
        p_moreNotifs) =
    VAR
        l_prio_idx,
        l_prio_idx1,
        l_continue,
        l_prio,
        l_sub_queue,
        l_nb_sub,
        l_nb_prio
    IN
        set_subscription (p_subscription);
        set_subscription_state (p_subscription, p_state, 3);
        set_subscription_session (p_subscription, p_session);
        set_subscription_priority (p_subscription, p_priority);
        set_subscription_publishInterval (p_subscription, p_revPublishInterval);
        set_subscription_MaxLifetimeAndKeepAliveCount (p_subscription, p_revLifetimeCount, p_revMaxKeepAlive);
        set_subscription_LifetimeAndKeepAliveCounter(p_subscription, p_revLifetimeCount, p_revKeepAliveCount);
        set_subscription_MaxNotifsPerPublish (p_subscription, p_maxNotificationsPerPublish);
        setreset_subscription_MessageSent (p_subscription, p_firstMsgSent);
        set_subscription_PublishingEnabled (p_subscription, p_publishEnabled);
        set_subscription_MoreNotifications (p_subscription, p_moreNotifs);
        set_subscription_SeqNum (p_subscription, p_seqNumInit);
        set_subscription_notifRepublishQueue (p_subscription, p_republishQueue);
        set_subscription_monitoredItemQueue (p_subscription, p_monitoredItemQueue);
        set_subscription_timer_id (p_subscription, p_timerId);
        log_subscription_transition (p_subscription, c_subscriptionState_indet, p_state, 3);
        l_nb_sub <-- get_card_session_seq_subscription(p_session);
        l_nb_prio <-- get_card_session_seq_priority (p_session);
        l_prio_idx <-- get_session_priority_idx (p_session, p_priority);

        IF l_prio_idx = 0 THEN
            // the added subscription has a priority that does not exist,
            // so it shall be inserted in the sequence of priorities
            // let's search for the new priority index (l_prio_idx)
            ASSERT
                l_nb_prio < k_n_subscriptionPerSession_max &
                a_session_seq_priority                (p_session) : 1..l_nb_prio >-> t_priority &
                a_session_priority_subscriptions_queue(p_session) : 1..l_nb_prio --> t_prioritySubQueue &
                p_priority /: ran(a_session_seq_priority(p_session))
            THEN
                l_prio_idx := l_nb_prio + 1;
                l_prio <-- getall_session_seq_priority (p_session, l_nb_prio);
                l_continue := bool(1 < l_prio_idx & l_prio /= c_priority_indet & p_priority < l_prio);
                IF l_continue = TRUE THEN
                    WHILE l_continue = TRUE
                    DO
                        l_prio_idx1 := l_prio_idx - 1;
                        // priorities higher than the subscription priority are swaped with +1 index
                        swap_session_seq_priority (p_session, l_prio_idx, l_prio_idx1);
                        l_sub_queue <-- get_session_priority_subscriptions_queue (p_session, l_prio_idx1);
                        set_session_priority_subscriptions_queue (p_session, l_prio_idx, l_sub_queue);
                        l_prio_idx := l_prio_idx1;
                        l_prio <-- getall_session_seq_priority (p_session, l_prio_idx1);
                        l_continue := bool(1 < l_prio_idx & l_prio /= c_priority_indet & p_priority < l_prio)
                    INVARIANT
                        l_prio_idx  : t_prio_idx_i  &
                        l_prio_idx  : 1 .. l_nb_prio + 1 &
                        l_continue  : BOOL          &
                        (l_continue = TRUE => 1 < l_prio_idx) &
                        a_session_seq_priority(p_session) : t_prio_idx >+> t_priority &
                        a_session_seq_priority = a_session_seq_priority$0 <+
                        {p_session |-> ({l_prio_idx} <<| a_session_seq_priority$0(p_session) <+
                                %idx.(idx : l_prio_idx + 1 .. l_nb_prio + 1 | a_session_seq_priority$0(p_session)(idx - 1)))} &
                        a_session_priority_subscriptions_queue = a_session_priority_subscriptions_queue$0 <+
                        {p_session |-> (a_session_priority_subscriptions_queue$0(p_session) <+
                                %idx.(idx : l_prio_idx + 1 .. l_nb_prio + 1 | a_session_priority_subscriptions_queue$0(p_session)(idx - 1)))} &
                        ran(a_session_seq_priority(p_session)) = ran(a_session_seq_priority$0(p_session))
                    VARIANT
                        l_prio_idx
                    END
                END;
                // insertion of the subscription priority
                insert_session_seq_priority (p_session, l_prio_idx, p_priority);
                set_session_priority_subscriptions_queue (p_session, l_prio_idx, p_prio_subs_queue)
            END
        END;

        // set the current subscription in the subscription sequence and
        // increment the number of substitutions
        set_card_session_seq_subscription (p_session, l_nb_sub + 1) // set new max value
    END
    ;

    delete_subscription (p_subscription) =
    VAR
        l_old_state,
        l_prio,
        l_session,
        l_priority,
        l_sub_prio_idx,
        l_prio_idx_it,
        l_prio_idx_it1,
        l_nb_prio,
        l_nb_sub_prio,
        l_prio_subs_queue,
        l_queue
    IN
        l_old_state    <-- get_subscription_state (p_subscription);
        log_subscription_transition (p_subscription, l_old_state, c_subscriptionState_indet, 25);
        l_session      <-- get_subscription_session (p_subscription);
        l_priority     <-- get_subscription_priority (p_subscription);
        l_sub_prio_idx <-- get_session_priority_idx (l_session, l_priority);
        IF l_sub_prio_idx /= 0 THEN
            l_nb_prio         <-- get_card_session_seq_priority (l_session);
            l_prio_subs_queue <-- get_session_priority_subscriptions_queue (l_session, l_sub_prio_idx);
            l_nb_sub_prio     <-- get_queue_nb_subs (l_prio_subs_queue);
            ASSERT
                l_sub_prio_idx : 1..l_nb_prio &
                a_session_seq_priority                (l_session) : 1..l_nb_prio >-> t_priority &
                a_session_priority_subscriptions_queue(l_session) : 1..l_nb_prio --> t_prioritySubQueue
            THEN
            IF l_nb_sub_prio = 1
            THEN
                remove_session_seq_priority (l_session, l_sub_prio_idx);
                l_prio_idx_it := l_sub_prio_idx;
                IF    l_prio_idx_it < l_nb_prio THEN
                WHILE l_prio_idx_it < l_nb_prio
                DO
                    // sub index data on subscriptions with a priority higher than the current priority are shifted of -1 index
                    // prio index on higher priority than the one removed are shifted of -1 index
                    l_prio_idx_it1 := l_prio_idx_it + 1;
                    l_prio <-- get_session_seq_priority (l_session, l_prio_idx_it1);
                    swap_session_seq_priority (l_session, l_prio_idx_it, l_prio_idx_it1);
                    l_queue <-- get_session_priority_subscriptions_queue (l_session, l_prio_idx_it1);
                    set_session_priority_subscriptions_queue (l_session, l_prio_idx_it, l_queue);
                    l_prio_idx_it := l_prio_idx_it1
                INVARIANT
                    l_prio_idx_it : t_prio_idx_i &
                    l_prio_idx_it : t_prio_idx &
                    l_sub_prio_idx <= l_prio_idx_it &
                    l_prio_idx_it  <= l_nb_prio &
                    a_session_seq_priority : t_session --> (t_prio_idx >+> t_priority) &
                    a_session_seq_priority = a_session_seq_priority$0 <+
                        {l_session |-> ({l_prio_idx_it} <<| a_session_seq_priority$0(l_session) <+
                                        %idx.(idx : l_sub_prio_idx .. l_prio_idx_it - 1 | a_session_seq_priority$0(l_session)(idx + 1)))} &
                    a_session_priority_subscriptions_queue = a_session_priority_subscriptions_queue$0 <+
                        {l_session |-> (a_session_priority_subscriptions_queue$0(l_session) <+
                                        %idx.(idx : l_sub_prio_idx .. l_prio_idx_it - 1 | a_session_priority_subscriptions_queue$0(l_session)(idx + 1)))}
                VARIANT
                    l_nb_prio - l_prio_idx_it
                END /* WHILE */
                END; /* IF */
                ASSERT l_prio_idx_it = l_nb_prio THEN
                // the subscription priority shall be removed
                // => previous last prio index data is invalidated (prio indexes were shifted in previous loop)
                remove_session_priority_subscriptions_queue(l_session, l_nb_prio);
                clear_and_deallocate_prio_queue (l_prio_subs_queue)
                END
            ELSIF l_nb_sub_prio > 1 THEN
                // subscription priority remains for other subscription(s)
                remove_subscription_from_queue (l_prio_subs_queue, p_subscription)
            END
        END
       END;
       del_subscription (p_subscription);
       // decrease nb of subs
       decrease_card_session_seq_subscription (l_session)
    END
    ;

    /* IMPORTANT: it shall not be called during iteration on subscriptions */
    reconfigure_session_priority_subscriptions_queue_last_sub (p_session, p_sub) =
    VAR
        l_prio,
        l_prio_idx,
        l_prio_sub_q
    IN
        l_prio     <-- get_subscription_priority (p_sub);
        l_prio_idx <-- get_session_priority_idx (p_session, l_prio);
        IF l_prio_idx /= 0 THEN
            l_prio_sub_q <-- get_session_priority_subscriptions_queue (p_session, l_prio_idx);
            reconfigure_priority_subscriptions_queue_last_sub (l_prio_sub_q, p_sub)
        END
    END

END

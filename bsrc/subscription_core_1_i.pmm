THEORY th_typage_pmm IS

    band(binhyp(a: d +-> (e --> f)),
    band(binhyp(dom(a) = d),
    band(binhyp(b: d),
    band(binhyp(e = 0..h),
    band(binhyp(h<=2147483647),
    band(binhyp(c: g),
         binhyp(g = i..h)))))))
    =>
    a(b)(c)<=2147483647
    ;

    band(binhyp(a: d +-> e),
    band(binhyp(dom(a) = d),
    band(binhyp(b: d),
    band(binhyp(c <: a),
    band(binhyp(dom(c) = f),
         binhyp(b: f))))))
    =>
    a(b) = c(b)
    ;

    band(binhyp(b: g +-> h),
    band(binhyp(f <: g),
    band(binhyp(a <: f),
    band(binhyp(i = a<|b|>e),
    band(binhyp(e <: h),
    band(binhyp(dom(i) = a),
    band(binhyp(c: g),
    band(binhyp(c: a),
    band(binhyp(d: h),
         binhyp(d: e))))))))))
    =>
    dom(a<|(b<+{c|->d})|>e) = a
    ;

    band(binhyp(b: g +-> e),
    band(binhyp(h <: g),
    band(binhyp(a <: h),
    band(binhyp(i <: e),
    band(binhyp(c: dom(f)),
    band(binhyp(d: i),
    band(binhyp(dom(f) = a),
         binhyp(f = a<|b|>e))))))))
    =>
    a<|(b<+{c|->d})|>e = f<+{c|->d}
    ;

    band(binhyp(b: f +-> e),
    band(binhyp(dom(b) = f),
    band(binhyp(g = a<|b|>e),
    band(binhyp(a <: h),
    band(binhyp(h <: f),
    band(binhyp(c: dom(g)),
    band(binhyp(d: i),
         binhyp(i <: e))))))))
    =>
    dom(a<|(b<+{c|->d})|>e) = a
    ;

    band(binhyp(b: f +-> g),
    band(binhyp(dom(b) = f),
    band(binhyp(h = a<|b|>e),
    band(binhyp(dom(h) = a),
    band(binhyp(a <: i),
    band(binhyp(i <: f),
    band(binhyp(c: dom(h)),
    band(binhyp(d: e),
         binhyp(e <: g)))))))))
    =>
    dom(a<|(b<+{c|->d})|>e) = a
    ;

    band(binhyp(b: g +-> h),
    band(binhyp(dom(b) = g),
    band(binhyp(f = a<|b|>e),
    band(binhyp(a <: g),
    band(binhyp(e <: h),
    band(binhyp(c: a),
         binhyp(d: e)))))))
    =>
    a<|(b<+{c|->d})|>e = f<+{c|->d}

END
&
THEORY th_ineg_pmm IS

    band(binhyp(a: d +-> (e --> f)),
    band(binhyp(dom(a) = d),
    band(binhyp(b: d),
    band(binhyp(c: e),
         binhyp(f = 0..g)))))
    =>
    0 <= a(b)(c)

END
&
THEORY th_inverse_pmm IS

    /* not proved by pp */
    band(binhyp(b: g +-> (f >+> e)),
    band(binhyp(b: g +-> iseq(e)),
    band(binhyp(dom(b) = g),
         binhyp(c: g)))) &
    d\ (a,b,c) &
    2 <= a &
    a <= card(dom(b(c)))+1
    =>
    ({a-1}<<|b(c)<+%d.(d: a..card(dom(b(c)))+1 | b(c)(d-1)))~: e +-> f

END
&
THEORY th_dom_pmm IS

    dom(a <+ b <+ c) == dom(a) \/ dom(b) \/ dom(c)
    ;

    /* not proved by pp */
    band(binhyp(b: 1..d +-> e),
         binhyp(dom(b) = 1..d)) &
    c\ (a,d) &
    a: 1..d+1
    =>
    card(dom({a}<<|b<+%c.(c: a+1..d+1 | b(c-1)))) = d

END
&
THEORY th_ran_pmm IS

    /* not proved by pp */
    band(binhyp(b: 1..d +-> e),
         binhyp(dom(b) = 1..d)) &
    c\ (a,d) &
    a: 2..d+1
    =>
    ran({a-1}<<|b<+%c.(c: a..d+1 | b(c-1))) = ran(b)
    ;

    /* not proved by pp */
    a\ (b)
    =>
    ran(%a.(a: b | c(d))) <: ran(c)

END
&
THEORY th_seq_pmm IS

    binhyp(a: 1..b +-> d) &
    binhyp(a~: d +-> 1..b) &
    binhyp(dom(a) = 1..b) &
    binhyp(not(c: ran(a))) &
    0 <= b
    =>
    a<+{b+1|->c}: iseq(d)
    ;

    /* not proved by pp */
    binhyp(dom(b) = 1..d) &
    binhyp(b: 1..d +-> f) &
    binhyp(b~: f +-> 1..d) &
    binhyp(1<=a) &
    binhyp(a<=1+d) &
    binhyp(not(e: ran(b)))
    =>
    {a}<<|b<+%c.(c: 1+a..1+d | b(-1+c))<+{a|->e}: iseq(f)
    ;

    /* not proved by pp */
    band(binhyp(b: 1..a +-> e),
    band(binhyp(b~: e +-> 1..a),
    band(binhyp(dom(b) = 1..a),
         binhyp(1 <= d))))
    =>
    {a}<<|b<+%c.(c: d..a-1 | b(c+1)): iseq(e)
    ;

    /* not proved by pp */
    band(binhyp(dom(b) = 1..g),
    band(binhyp(1 <= d),
         binhyp(1+a <= g))) &
    b: e >+> f &
    d <= a
    =>
    {a+1}<<|b<+%c.(c: d..a | b(c+1)): e >+> f
    ;

    /* not proved by pp */
    binhyp(a: d +-> iseq(e)) &
    binhyp(dom(a) = d) &
    binhyp(b: d) &
    binhyp(not(c: ran(a(b))))
    =>
    a<+{b|->(a(b)<+{card(dom(a(b)))+1|->c})}: d +-> iseq(e)
    ;

    /* not proved by pp */
    binhyp(b: iseq(e)) &
    binhyp(d: e) &
    binhyp(not(d: ran(b))) &
    c\ (a,b) &
    a: 1..card(dom(b))+1
    =>
    {a}<<|b<+%c.(c: a+1..card(dom(b))+1 | b(c-1))<+{a|->d}: seq(e)

END
&
THEORY th_empty_empty_pmm IS

    a<|b = {} &
    c = {}
    =>
    a<|b = c

END
&
THEORY th_empty_pmm IS

    not(a: dom(b))
    =>
    {a}<|b = {}
    ;

    not(b: a)
    =>
    a<|{b|->c} = {}

END
&
THEORY th_simp_pmm IS

    /* not proved by pp */
    binhyp(a<=b) &
    blvar(c) &
    c\ (a,b)
    =>
    card(a+1..b) == b-a
    ;

    binhyp(1<=a) &
    binhyp(1<=b) &
    binhyp(b<=a+1) &
    blvar(c) &
    c\ (a,b)
    =>
    1..a\/b..a+1 == 1..a+1
    ;

    binhyp(a<=b) &
    blvar(c) &
    c\ (a,b)
    =>
    {a}\/a+1..b == a..b
    ;

    a-b\/c\/b == a\/(b\/c)
    ;

    binhyp(1<=a) &
    binhyp(1<=b) &
    binhyp(b<=a+1) &
    blvar(c) &
    c\ (a,b)
    =>
    1..a\/b+1..a+1\/{b} == 1..a+1
    ;

    /* not proved by pp */
    binhyp(1 <= a) &
    binhyp(b: 1..a) &
    blvar(c) &
    c\ (a,b)
    =>
    card((1..a)-{b}\/b+1..a+1/\{b}) == 0
    ;

    /* not proved by pp */
    binhyp(1 <= a) &
    binhyp(b: 1..a) &
    blvar(c) &
    c\ (a,b)
    =>
    card((1..a/\b+1..a+1)-{b}) == a-b
    ;

    /* not proved by pp */
    binhyp(a: 1..b) &
    blvar(c) &
    c\ (a,b)
    =>
    card(a+1..b+1) == b-a+1
    ;

    /* not proved by pp */
    binhyp(1 <= a) &
    binhyp(b: 1..a) &
    blvar(c) &
    c\ (a,b)
    =>
    card((1..a)-{b}) == a-1
    ;

    binhyp(a: e +-> f) &
    c <= d &
    blvar(g) &
    g\ (a,c,d) &
    b\ (c,d)
    =>
    a<+%b.(b: c+1..d | a(b-1))<+{c|->a(c-1)} == a<+%b.(b: c..d | a(b-1))
    ;

    binhyp(b: e +-> f) &
    a <= d &
    blvar(g) &
    g\ (a,b,d) &
    c\ (a,d)
    =>
    {a-1}<<|({a}<<|b<+%c.(c: a+1..d | b(c-1)))<+{a|->b(a-1)} == {a-1}<<|b<+%c.(c: a..d | b(c-1))
    ;

    binhyp(b: f +-> g) &
    a-1: dom(b) &
    blvar(h) &
    h\ (a,b) &
    c\ (a,d)
    =>
    ({a}<<|b<+%c.(c: a+1..d | e))(a-1) == b(a-1)
    ;

    binhyp(a: f +-> g) &
    c-1: dom(a) &
    blvar(h) &
    h\ (a,c) &
    b\ (c, e)
    =>
    (a<+%b.(b: c+1..e | d))(c-1) == a(c-1)
    ;

    binhyp(dom(b) = c..a) &
    blvar(d) &
    d\ (a,b)
    =>
    {a+1}<<|b == b
    ;

    binhyp(a : S +-> T) &
    blvar(f) &
    f\ (a,c,d) &
    b\ (c,d) &
    c<=d
    =>
    a<+%b.(b: c..d-1 | a(b+1))<+{d|->a(d+1)} == a<+%b.(b: c..d | a(b+1))
    ;

    binhyp(a : S +-> T) &
    blvar(f) &
    f\ (a,d) &
    b\ (c,d) &
    d+1: dom(a)
    =>
    (a<+%b.(b: c..d-1 | e))(d+1) == a(d+1)
    ;

    binhyp(a : S +-> T) &
    blvar(f) &
    f\ (a,c,d) &
    b\ (c,d) &
    c<=d
    =>
    {d+1}<<|({d}<<|a<+%b.(b: c..d-1 | a(b+1)))<+{d|->a(d+1)} == {d+1}<<|a<+%b.(b: c..d | a(b+1))
    ;

    binhyp(a : S +-> T) &
    blvar(f) &
    f\ (a,d) &
    b\ (c,d) &
    d+1: dom(a)
    =>
    ({d}<<|a<+%b.(b: c..d-1 | e))(d+1) == a(d+1)
    ;

    /* SimplifyRelFonXY.10 (Backward) */
    (r<+{a|->b})(a) == b
    ;

    a+1-1 == a
    ;

    a-1+1 == a

END

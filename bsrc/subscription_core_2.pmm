THEORY User_Pass IS
Pattern(a<+{b|->({c}<<|a(b)<+{d|->a(b)(c)})} : e +-> (f>+>g))
    & ff(0) & pr(Tac(th_type))
END &

THEORY th_smp IS

    not(a = {})
    =>
    not(card(a) = 0)

END
&

THEORY th_card IS

    band(binhyp(a : c +-> d),
         binhyp(c = 1..b)) &
    not(dom(a) = c)
    =>
    not(card(a) = b)

END  &

THEORY th_type IS

    b: d >+> e &
    a: dom(b) &
    c: d &
    not(c: dom(b))
    =>
    {a}<<|b<+{c|->b(a)}: d >+> e

END

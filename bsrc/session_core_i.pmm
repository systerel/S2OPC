&

THEORY Simp_Delete IS

  band(binhyp(not(x: A)),
       binhyp(r: B +-> A)) &
  blvar(Q) & Q\(x,r)
  =>
  r|>>{x} == r
;
  band(binhyp(not(x: A)),
       binhyp(r: A <-> B)) &
  blvar(Q) & Q\(x,r)
  =>
  {x}<<|r == r

END

&

THEORY membership IS

   /* Rule Systerel.1209 - bd.196 [ed053ce51e3ffa52db1ab0c709b77107] */
   bcall1(BackwardRule(Systerel.1209)) &
   binhyp(a : dom(c)) &
   dom(c) : POW(b)
   =>
   a : b
   ;
   /* Rule Systerel.362 - bd.353 [b00b8dcb73f4096087bee756b833c7e7] */
   bcall1(AtomicRule(Systerel.362))
   =>
   {a} /\ b = {} == not(a : b)

END

&

THEORY dom_eq IS

   /* Rule Systerel.33 - bd.31 [c0c2bd8666718a180123c7e4af086a36] */
   bcall1(BackwardRule(Systerel.33)) &
   binhyp(dom(a) = b) &
   blvar(c) &
   c\(a,b)
   =>
   dom(a) == b

END

&

THEORY dom_rewrite IS

   /* Rule Systerel.1033 - bd.21 [ec6ddedaa40186472c78a674bd49151a] */
   bcall1(BackwardRule(Systerel.1033)) &
   binhyp({c} <<| a = {c} <<| b) &
   bguard(th_fct : (a : dom(a) +-> ran(a))) &
   c : dom(a) &
   bnot(bpattern(c,(d,e))) &
   blvar(f) &
   f\(a,b,c)
   =>
   dom(a) == dom(b <+ {c |-> a(c)})

END

&

THEORY simplify_restriction IS

   /* Rule Systerel.225 - bd.222 [62e97f2ce8686d0b7a26f0da8cc1dd3e] */
   bcall1(BackwardRule(Systerel.225)) &
   not(c : a) &
   blvar(e) &
   e\(a,c)
   =>
   a <| (b <+ {c |-> d}) == a <| b

END

&

THEORY simplify_override IS

   /* Rule Systerel.220 - bd.217 [a45859aa1b784701412069c8f12b41c5] */
   bcall1(AtomicRule(Systerel.220))
   =>
   a <+ {b |-> c} == {b} <<| a \/ {b |-> c}
;
   /* Rule Systerel.1383 - bd.369 [ed2599c7ef730d4bf77fc232a8e76216] */
   bcall1(BackwardRule(Systerel.1383)) &
   not(c : dom(b)) &
   blvar(d) &
   d\(b,c)
   =>
   (a <+ b)(c) == a(c)

END

&

THEORY simplify_inverse IS

   /* Rule Systerel.41 - bd.39 [c8086410f509040af5ad5973792d1f25] */
   bcall1(BackwardRule(Systerel.41)) &
   binhyp(b : d +-> e) &
   a : dom(b) &
   blvar(f) &
   f\(a,c,b)
   =>
   a : b~[{c}] == (b(a) = c)
;
   /* Rule Systerel.755 - bd.743 [bde94360ffc04991f194370d817ed7b0] */
   bcall1(BackwardRule(Systerel.755)) &
   binhyp(b : d +-> e) &
   a : dom(b) &
   blvar(f) &
   f\(a,b)
   =>
   a : b~[c] == (b(a) : c)

END

&

THEORY simplify_dom_subtraction IS

   /* Rule Systerel.1598 - bd.583 [60d9c0db22906230fb64645462206e81] */
   bcall1(BackwardRule(Systerel.1598)) &
   dom(b) /\ a = {} &
   blvar(c) &
   c\(b,a)
   =>
   a <<| b == b
;
   /* Rule Systerel.1501 - bd.486 [9cb062da1e506b775826bb6083f75557] */
   bcall1(BackwardRule(Systerel.1501)) &
   binhyp(b = d) &
   blvar(e) &
   e\(b,d)
   =>
   a <<| b = c == (a <<| d = c)

END

&

THEORY diff_distrib_union IS

   /* Rule Systerel.1554 - bd.539 [d4c54317cac88971cf38900c117ea05d] */
   bcall1(BackwardRule(Systerel.1554))
   =>
   (a \/ b)-c == a-c \/ b-c

END

&

THEORY inclusion_transitivity IS

   /* Rule Systerel.1123 - bd.111 [60d1a3c1671867ea2157daca8c308ced] */
   bcall1(BackwardRule(Systerel.1123)) &
   a : POW(b)
   =>
   a : POW(b \/ c)

END

&

THEORY cartesian_factorisation IS

   /* Rule Systerel.459 - bd.449 [e07301ce67aee24aaa9b2ba45a82d4d5] */
   bcall1(AtomicRule(Systerel.459))
   =>
   a*b /\ c*b == (a /\ c)*b

END

&

THEORY De_Morgan_law IS

   /* Rule Systerel.1256 - bd.243 [819ee8b20d2963ef3ccf16c2f2a6023c] */
   bcall1(AtomicRule(Systerel.1256))
   =>
   not(a & b) == (not(a) or not(b))

END

    & ff(0) & ah(dom(a_NonceClient) <: dom(s_client_session<|a_state|>>{e_session_init})) & pp(rt.0);

/* FIN client_close_sessions_sm */

/* server_close_sessions */

Operation(server_close_sessions) & Pattern(a: b +-> c)
    & ff(0) & ah(dom(a_client_token) = dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(a: b +-> c)
    & ff(0) & ah(dom(a_NonceClient) <: dom(s_client_session<|a_state|>>{e_session_init})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a<|b) = dom(a<|c|>>d))
    & ff(0) & ah(dom(a_channel) = dom(a_state|>>{e_session_init,e_session_scOrphaned})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a<|b) = dom(c<<|(d<|e)|>>f))
    & ff(0) & ah(dom(a_user_server) = dom(s_client_session<<|a_state|>>{e_session_created})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(ran(a) = b)
    & ff(0) & ah(ran(a_server_token) = s_session-s_client_session) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a) = dom(b<|(c<|d)|>>e))
    & ff(0)& ah(dom(a_client_token) = dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a) = dom(b<|(c<|d)|>e))
    & ff(0) & ah(dom(a_client_orphaned) = dom(s_client_session<|a_state|>{e_session_scOrphaned})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a<|b) <: dom(c<|d|>>e))
    & ff(0) & ah(dom(a_NonceServer) <: dom(a_state|>>{e_session_init,e_session_creating})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a) <: dom(b<|(c<|d)|>>e))
    & ff(0) & ah(dom(a_NonceClient) <: dom(s_client_session<|a_state|>>{e_session_init})) & pp(rt.0);

Operation(server_close_sessions) & Pattern(dom(a<|b) <: dom(c<<|(d<|e)|>>f))
    & ff(0) & ah(dom(a_session_roles) <: dom(s_client_session<<|a_state|>>{e_session_created})) & pp(rt.0);

/* FIN server_close_sessions */

/* client_close_session_req_sm */

Operation(client_close_session_req_sm) & Pattern(dom(a) = dom(b|>>c))
    & ff(0) & mp(Tac(rewriting)) & eh(dom(a_channel),_h,Goal) & ar(SimplifyRelRaaLongXY.6,Goal) & ar(SimplifyRelDomXY.19,Goal) & mp
    & ar(AssociativityXY.3,Goal) & ah(dom({session|->e_session_closing}|>>{e_session_init,e_session_scOrphaned}) = {session}) & pr
    & dd & eh(dom({session|->e_session_closing}|>>{e_session_init,e_session_scOrphaned}),_h,Goal) & mp & ar(SimplifyRelImaLongXY.6,Goal)
    & dc(a_state(session),{e_session_created,e_session_userActivating,e_session_userActivated}) & pr & pr & pr;

Operation(client_close_session_req_sm) & Pattern(dom(a) = dom(b|>>c))
    & ff(0) & mp(Tac(rewriting)) & eh(dom(a_client_token),_h,Goal) & ar(CommutativityXY.20,Goal) & ar(SimplifyRelRaaLongXY.6,Goal) & ar(SimplifyRelDorLongXY.3,Goal)
    & ar(SimplifyRelDomXY.19,Goal) & mp & ah(s_client_session/\dom({session|->e_session_closing}|>>{e_session_init,e_session_creating}) = {session})
    & pr & dd & eh(s_client_session/\dom({session|->e_session_closing}|>>{e_session_init,e_session_creating}),_h,Goal) & ar(SimplifySetSubXY.5,Goal) & ar(AssociativityXY.3,Goal)
    & mp & ar(SimplifyRelImaLongXY.6,Goal) & dc(a_state(session),{e_session_created,e_session_userActivating,e_session_userActivated}) & pr & pr & pr;

Operation(client_close_session_req_sm) & Pattern(dom(a) = dom(b|>c))
    & ff(0) & eh(dom(a_client_orphaned),_h,Goal) & mp & ar(SimplifyRelImaLongXY.5,Goal) & mp
    & dc(a_state(session),{e_session_created,e_session_userActivating,e_session_userActivated}) & pr & pr & pr;

Operation(client_close_session_req_sm) & Pattern(dom(a) : POW(dom(b)))
    & ff(0) & mp(Tac(rewriting)) & ar(SimplifyRelRaaLongXY.6,Goal) & ar(SimplifyRelDomXY.19,Goal)
    & ah(dom({session|->e_session_closing}|>>{e_session_init,e_session_creating}) = {session}) & pr
    & dd & eh(dom({session|->e_session_closing}|>>{e_session_init,e_session_creating}),_h,Goal) & ar(CommutativityXY.21,Goal) & ar(SimplifyRelDomXY.13,Goal) & mp
    & ah(dom(a_state|>>{e_session_init,e_session_creating}) = dom(a_state)-a_state~[{e_session_init,e_session_creating}]) & pr
    & dd & eh(dom(a_state|>>{e_session_init,e_session_creating}),_h,AllHyp) & pr;

Operation(client_close_session_req_sm) & Pattern(dom(a) : POW(dom(b)))
    & ff(0) & mp(Tac(rewriting)) & ar(CommutativityXY.20,Goal) & ar(SimplifyRelRaaLongXY.6,Goal) & ar(SimplifyRelDorLongXY.3,Goal) & ar(SimplifyRelDomXY.19,Goal) & mp
    & mp(Tac(SimplifySetSubXY; AssociativityXY)) & ah(dom(s_client_session<|a_state|>>{e_session_init}) = (s_client_session/\dom(a_state))-a_state~[{e_session_init}])
    & ar(CommutativityXY.20,Goal) & pr & dd & eh(dom(s_client_session<|a_state|>>{e_session_init}),_h,AllHyp) & pr;

Operation(client_close_session_req_sm)
    & ff(0) & mp(Tac(simplify));

/* FIN client_close_session_req_sm */

/* may_close_unactivated_session */

Operation(may_close_unactivated_session) & Pattern(dom({l_session}<<|a_client_token) = dom(s_client_session-{l_session}<|({l_session}<<|a_state)|>>{e_session_init,e_session_creating}))
    & ff(0)
    & dd & ar(SimplifyRelDomXY) & ar(SimplifyRelDorLongXY) & ar(SimplifyRelDorXY) & ar(SimplifyRelDorLongXY) & ss & ah(({l_session}<|a_state)-({l_session}<|a_state) = {}) & pr & dd & eh(({l_session}<|a_state)-({l_session}<|a_state),_h,Goal) & ar(SimplifySetSubXY) & ah(dom((s_client_session<|a_state|>>{e_session_init,e_session_creating})-({l_session}<|a_state)) = dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})-{l_session}) & pp(rt.0) & dd & eh(dom((s_client_session<|a_state|>>{e_session_init,e_session_creating})-({l_session}<|a_state)),_h,Goal) & pr;

Operation(may_close_unactivated_session) & Pattern(dom({l_session}<<|a_NonceClient) <: dom(s_client_session-{l_session}<|({l_session}<<|a_state)|>>{e_session_init}))
    & ff(0) & dd(0) & ar(SimplifyRelDomXY) & ar(SimplifyRelDorLongXY) & ar(SimplifyRelDorXY) & ar(SimplifyRelDorLongXY) & ah(({l_session}<|a_state)-({l_session}<|a_state) = {}) & pr & dd & eh(({l_session}<|a_state)-({l_session}<|a_state),_h,Goal) & ar(SimplifySetSubXY) & ah(dom((s_client_session<|a_state)-({l_session}<|a_state)|>>{e_session_init}) = dom(s_client_session<|a_state|>>{e_session_init})-{l_session}) & pp(rt.0) & dd & eh(dom((s_client_session<|a_state)-({l_session}<|a_state)|>>{e_session_init}),_h,Goal) & pr;

/* Fin may_close_unactivated_session */

/* Patterns to close session */
Pattern(dom(a<<|a_channel) = dom(c|>>d))
    & ff(0) & mp & ar(CommutativityXY.21,Goal) & ar(SimplifyRelDomXY.13,Goal) & pr;

Pattern(dom(a<<|a_user_server) = dom(c|>>d))
    & ff(0) & mp & eh(dom(a_user_server),_h,Goal) & ar(CommutativityXY.21,Goal) & ar(SimplifyRelDomXY.13,Goal) & pr;

Pattern(ran(a_server_token|>>b) = c-b-(d-b))
    & ff(0) & mp & eh(ran(a_server_token),_h,Goal) & ar(AssociativityXY.3,Goal) & pr;

Pattern(dom(a<<|a_NonceServer) : POW(dom(c)))
    & ff(0) & mp & ar(CommutativityXY.21,Goal) & ar(SimplifyRelDomXY.13,Goal) & pr
    & ah(dom(a_state|>>{e_session_init,e_session_creating}) = dom(a_state)-a_state~[{e_session_init,e_session_creating}]) & pr
    & dd & eh(dom(a_state|>>{e_session_init,e_session_creating}),_h,AllHyp) & pr;

Pattern(dom(a<<|a_session_roles) : POW(dom(c)))
    & ff(0) & mp & ar(CommutativityXY.21,Goal) & mp & ah(dom(s_client_session<<|a_state|>>{e_session_created}) = dom(a_state)-a_state~[{e_session_created}]-s_client_session)
    & ar(CommutativityXY.21,Goal) & pr & dd & eh(dom(s_client_session<<|a_state|>>{e_session_created}),_h,AllHyp) & pr;

Pattern(dom(a<<|a_client_token) = dom(c|>>d))
    & ff(0) & mp & ar(SimplifyRelDorLongXY.7,Goal) & mp & eh(dom(a_client_token),_h,Goal) & dc(a_state(session) : {e_session_init,e_session_creating}) & dd
    & ah(dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})-{session} = dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})) & pr
    & dd & eh(dom(s_client_session<|a_state|>>{e_session_init,e_session_creating})-{session},_h,Goal)
    & ah({session|->a_state(session)}/<:s_client_session<|a_state|>>{e_session_init,e_session_creating}) & ah(a_state(session) : {e_session_init,e_session_creating})
    & pp(rt.0) & pr & dd & ah({session|->a_state(session)} <: s_client_session<|a_state|>>{e_session_init,e_session_creating})
    & ah(not(a_state(session) : {e_session_init,e_session_creating})) & pp(rt.0) & ah(s_client_session<|a_state|>>{e_session_init,e_session_creating} : s_session +-> t_sessionState)
    & pr & dd & dd & pr;

/* preuve par tentatives */
ff(0) & pr & bb(tp(Hyp) & pr & ll(?))

END
&

THEORY rewriting IS
   /* Rule Systerel.220 - bd.217 [a45859aa1b784701412069c8f12b41c5] */
   bcall1(AtomicRule(Systerel.220))
   =>
   a <+ {b |-> c} == {b} <<| a \/ {b |-> c}
END
&

THEORY simplify IS
   /* Rule Systerel.77 - bd.75 [a176fa587349458576e2b45037118df0] */
   bcall1(AtomicRule(Systerel.77))
   =>
   {a} <| (b <+ {a |-> c}) == {a |-> c}
   ;

   /* Rule Systerel.1126 - bd.114 [20dfc5a7ca939d4c1e34f13dd28b7f83] */
   bcall1(BackwardRule(Systerel.1126)) &
   binhyp(c : e +-> f) &
   blvar(g) &
   g\c
   =>
   a \/ {b} <| (c <+ {b |-> d}) == a <| c <+ {b |-> d}
   ;

   /* Rule Systerel.318 - bd.310 [b064664343dcec9c836743b080d47395] */
   bcall1(BackwardRule(Systerel.318)) &
   dom(c) : POW(a) &
   blvar(d) &
   d\(a,c)
   =>
   a <<| (b <+ c) == a <<| b
END
&

THEORY simplify_2 IS
   /* Rule Systerel.1598 - bd.583 [60d9c0db22906230fb64645462206e81] */
   bcall1(BackwardRule(Systerel.1598)) &
   dom(b) /\ a = {} &
   blvar(c) &
   c\(b,a)
   =>
   a <<| b == b
   ;

   /* Rule Systerel.473 - bd.463 [6d667735380a6b15c2ebeaa4bb458eee] */
   bcall1(AtomicRule(Systerel.473))
   =>
   a-{b} \/ {b} == a \/ {b}
END

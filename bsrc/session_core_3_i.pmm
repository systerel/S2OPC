THEORY User_Pass IS
Operation(Initialisation)
    & ff(0) & pr(Tac(initZ));

Operation(Initialisation) & Pattern(ran(a<|b*{c})/\d = {})
    & ff(0) & pr(Tac(initZ)) & eh(t_ApplicationDescription,_h,Goal) & pr;

Operation(Initialisation) & Pattern(ran(a<|b*{c})/\d = {})
    & ff(0) & pr(Tac(initZ)) & eh(t_CertThumbprint,_h,Goal) & pr;

Operation(Initialisation) & Pattern(ran(a<|b*{c})/\d = {})
    & ff(0) & pr(Tac(initZ)) & eh(t_SessionName,_h,Goal) & pr;

Operation(set_session_roles_2) & Pattern(a<|b|>c : a +-> c)
    & ff(0) & mp & ah(a_session_roles_i$1<+{p_session|->p_roles} : t_session_i +-> t_sessionRoles_i) & pr & pr;

Operation(set_session_roles_2) & Pattern(a<|b|>d = e)
    & ff(0) & pr(Tac(JSP));

Operation(set_client_session) & Pattern(a<|(b<+c) = d<+{e})
    & ff(0) & pr(Tac(rewriting_2));

Operation(is_valid_session) & Pattern(bool(not(a_state_i$1(session) = e_session_closed)) = bool(session: dom(a_state)))
    & ff(0) & dd(0) & eh(a_state,_h,Goal) & ah(a_state_i$1 : t_session_i +-> t_sessionState_i) & ah(session : dom(a_state_i$1)) & pr & pp(rt.0);

Operation(is_client_session) & Pattern(a = bool(b))
    & ff(1) & pr;

Operation(reset_session_state) & Pattern(a<+b|>>{c} = {d}<<|e)
    & ff(0) & pr & ar(CommutativityXY.19,Goal) & pr & pp(rt.0);

Operation(reset_session_state) & Pattern(a<+b|>>{c} <: a<+b)
    & ff(0) & pr(Tac(InPOWLeavesXY));

Operation(getall_session_channel) & Pattern(bool(a : b) = bool(c : d))
    & ff(0) & pr & ah(p_session : dom(a_channel)) & eh(a_channel,_h,Goal) & pr(Tac(restriction)) & pr;

Operation(getall_session_channel) & Pattern(a(b) : c)
    & ff(0) & dd(0) & ah(p_session : dom(a_channel)) & eh(a_channel,_h,Goal) & pr(Tac(restriction));

Operation(increase_channel_nb_sessions) & Pattern(a(b)+c<=d)
    & ff(0) & eh(a_channel_nb_sessions,_h,Goal) & pr;

Operation(increase_channel_nb_sessions) & Pattern(a<|(b<+c) = d<+{e})
    & ff(0) & pr(Tac(SimplifyRelFonXY; rewriting_2));

Operation(increase_channel_nb_sessions) & Pattern(a<+{b} : c +-> d)
    & ff(0) & pr & ah(a_channel_nb_sessions(p_channel)+1<=2147483647) & eh(a_channel_nb_sessions,_h,Goal) & pr;

Operation(decrease_channel_nb_sessions) & Pattern(a<|(b<+c) = d<+{e})
    & ff(0) & pr(Tac(SimplifyRelFonXY; rewriting_2));

Operation(decrease_channel_nb_sessions) & Pattern(a<+{b} : c +-> d)
    & ff(0) & pr & ah(0<=a_channel_nb_sessions(p_channel)-1) & pr & eh(a_channel_nb_sessions,_h,Goal) & pr & pr;

Operation(getall_to_create) & Pattern(bool(a : b) = bool(c : d))
    & ff(0) & pr & ah(p_session : dom(a_client_to_create)) & eh(a_client_to_create,_h,Goal) & pr(Tac(restriction));

Operation(getall_orphaned) & Pattern(bool(a : b) = bool(c : d))
    & ff(0) & pr & ah(p_session : dom(a_client_orphaned)) & eh(a_client_orphaned,_h,Goal) & pr(Tac(restriction));

Operation(reset_server_session_preferred_locales) & Pattern(c_LocaleIds_indet = a_server_client_locales(p_session))
    & ff(0) & mp & fh(a_server_client_locales_i$1(p_session) = c_LocaleIds_empty) & ah(a_server_client_locales_i$1(p_session) = a_server_client_locales(p_session))
    & pr(Tac(equality)) & dd & eh(a_server_client_locales_i$1(p_session),_h,Goal) & pr;

Operation(reset_server_session_preferred_locales) & Pattern(a_server_client_locales_i$1(p_session) = c_LocaleIds_indet)
    & ff(0) & mp & fh(a_server_client_locales(p_session) = c_LocaleIds_empty) & ah(a_server_client_locales_i$1(p_session) = a_server_client_locales(p_session))
    & pr(Tac(equality)) & dd & eh(a_server_client_locales(p_session),_h,Goal) & pr;

Operation(reset_server_session_preferred_locales) & Pattern({a}<<|b : POW(c<|d))
    & ff(0) & pr(Tac(rewriting; reset_auth)) & ah(a_server_client_locales <: t_session<|a_server_client_locales_i$1) & pp(rt.0) & pr & pr;

Operation(reset_server_session_user_auth_attempts) & Pattern({a}<<|b : POW(c<|d))
    & ff(0) & pr(Tac(reset_auth));

Operation(reset_server_client_create_session_info) & Pattern(a<|(b<+{c|->d})|>e = {c}<<|f)
    & ff(0) & pr(Tac(JSP)) & eh(t_ApplicationDescription,_h,Goal) & pr;

Operation(reset_server_client_create_session_info) & Pattern(a<|(b<+{c|->d})|>e = {c}<<|f)
    & ff(0) & pr(Tac(JSP)) & eh(t_CertThumbprint,_h,Goal) & pr;

Operation(reset_server_client_create_session_info) & Pattern(a<|(b<+{c|->d})|>e = {c}<<|f)
    & ff(0) & pr(Tac(JSP)) & eh(t_SessionName,_h,Goal) & pr;

Pattern(a<|(b<+c)|>d = e<+{f|->g})
    & ff(0) & pr(Tac(JSP));

Pattern(a<+b|>>{c} = d<+{e})
    & ff(0) & pr(Tac(rewriting_2));

Pattern(a<|b|>c = {d}<<|e)
    & ff(0) & pr(Tac(JSP));

Pattern(a<+{b} : POW(c<|d))
    & ff(0) & pr(Tac(SimplifyRelDorLongXY; JSP));

Pattern(a(b) = c(b))
    & ff(0) & pr(Tac(equality));

/* preuve par tentatives */
   ff(0) & pr & bb(tp(Hyp) & pr & ll(?))

END
&

THEORY initZ IS
   /* Rule Systerel.722 - bd.710 [644108ef70c6aa70f0be89e5054f7ef4] */
   a : POW(b) &
   blvar(d) &
   d\(a,b,c)
   =>
   a <| b*{c} == a*{c}
END
&

THEORY JSP IS
   /* Rule Systerel.1123 - bd.111 [60d1a3c1671867ea2157daca8c308ced] */
   a : POW(b)
   =>
   a : POW(b \/ c)
;

   /* Rule Systerel.627 - bd.616 [cd3978632cddb9d202aab7568e7bf75f] */
   binhyp(a : POW(c))
   =>
   a <+ b : POW(c <+ b)
;

   /* Rule Systerel.1583 - bd.568 [cd1ee071cd3d28a0fe53c53e24ed8653] */
   c : a &
   not(d : e)
   =>
   a <| (b <+ {c |-> d}) |> e = {c} <<| (a <| b |> e)
;

   /* Rule Systerel.1652 - bd.634 [3d2cbb68011868ced3ea4e5c344a8743] */
   c : a &
   d : e
   =>
   a <| (b <+ {c |-> d}) |> e = a <| b |> e <+ {c |-> d}
END
&

THEORY restriction IS
    /* Rule Systerel.1083 - bd.71 [6936dc39c950ba25b78d9f7819e051e9] */
   binhyp(a : b) &
   a : dom(c) &
   c : dom(c) +-> ran(c) &
   blvar(e) &
   e\(c,b,a)
   =>
   a : dom(b <| c |> d) == (c(a) : d)
END
&

THEORY equality IS
   /* Rule Systerel.1679 - bd.661 [e86317be38a9e34d8491ed8f797abc53] */
   c : dom(c) +-> ran(c) &
   binhyp(a : POW(c)) &
   blvar(d) &
   d\(a,c)
   =>
   a(b) == c(b)
END
&



THEORY rewriting IS
   /* Rule Systerel.220 - bd.217 [a45859aa1b784701412069c8f12b41c5] */
   bcall1(AtomicRule(Systerel.220))
   =>
   a <+ {b |-> c} == {b} <<| a \/ {b |-> c}
;

   /* Rule Systerel.1664 - bd.646 [86a00404d6ba516b4936b7103b20cf5e] */
   ran(c) /\ d = {} &
   blvar(e) &
   e\(c,d)
   =>
   a <| (b <+ c) |> d == dom(c) <<| (a <| b |> d)
END
&

THEORY rewriting_2 IS
   /* Rule Systerel.617 - bd.606 [5472b970ff35f56af86fa2f33ed713e8] */
   not(c = d) &
   blvar(e) &
   e\(c,d)
   =>
   a <+ {b |-> c} |>> {d} == a |>> {d} <+ {b |-> c}
;

   /* Rule Systerel.803 - bd.791 [526fbb74a004d6d6ab62c5e906015b9e] */
   binhyp(c : a) &
   blvar(e) &
   e\(a,c)
   =>
   a <| (b <+ {c |-> d}) == a <| b <+ {c |-> d}
END
&

THEORY reset_auth IS
   /* Rule Systerel.153 - bd.151 [9a6b43e5eb241dafc715f3d81453e26a] */
   b : POW(d) &
   c : POW(a)
   =>
   a <<| b : POW(c <<| d)
;

   /* Rule Systerel.1123 - bd.111 [60d1a3c1671867ea2157daca8c308ced] */
   a : POW(b)
   =>
   a : POW(b \/ c)
;

   /* Rule Systerel.220 - bd.217 [a45859aa1b784701412069c8f12b41c5] */
   bcall1(AtomicRule(Systerel.220))
   =>
   a <+ {b |-> c} == {b} <<| a \/ {b |-> c}
;

   /* Rule Systerel.803 - bd.791 [526fbb74a004d6d6ab62c5e906015b9e] */
   binhyp(c : a) &
   blvar(e) &
   e\(a,c)
   =>
   a <| (b <+ {c |-> d}) == a <| b <+ {c |-> d}
END

THEORY User_Pass IS
Operation(continue_iter_subscription_priority_queue) & Pattern(card(a\/b) = c)
    & ff(0) & dd(0) & ah(s_prio_sub_to_iterate_it-{l_subscription}\/(s_prio_sub_iterated_it\/{l_subscription}) = s_prio_sub_to_iterate_it\/s_prio_sub_iterated_it) & pp(rt.1 | 10) & dd & eh(s_prio_sub_to_iterate_it-{l_subscription}\/(s_prio_sub_iterated_it\/{l_subscription})) & pr;
Operation(add_subscription) & Pattern(a : POW(b\/c))
    & ff(0) & pr & bb(tp(Hyp) & pr & ll(?));
Operation(add_subscription) & Pattern(a : POW(b\/c))
    & ff(0) & mp & dc(p_moreNotifs,BOOL) & pr & pr;
Operation(add_subscription) & Pattern(a : POW(b\/c))
    & ff(0) & dd & dc(p_publishEnabled,BOOL) & pr & pr
END
&

THEORY th_seq IS

    a: b +-> iseq(c)
    =>
    a: b +-> iseq(c\/d)

END

THEORY User_Pass IS
Pattern(a : b <-> c)
    & ff(0) & pr & bb(tp(Hyp) & pr & ll(?));
Pattern(dom(a) = b)
    & ff(0) & pr & bb(tp(Hyp) & pr & ll(?));
Pattern(dom(a) = b)
    & ff(0) & mp & dc(p_queue : s_prioritySubQueue) & pr(Tac(th_card))
END &
THEORY th_card IS

    band(binhyp(a: d <-> e),
         binhyp(card(a[{b}]) /= 1)) &
    blvar(f) &
    f\ (a,b)
    =>
    dom(a-{b|->c}) == dom(a)

END

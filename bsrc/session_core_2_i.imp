IMPLEMENTATION
    session_core_2_i

REFINES
    session_core_2

SEES
    constants,
    request_handle_bs,
    message_out_bs,
    message_in_bs,
    channel_mgr

IMPORTS
    session_core_3

PROMOTES
    set_session_roles_2,
    get_session_roles,
    reset_session_to_create,
    reset_session_orphaned,
    is_valid_session,
    is_client_session,
    get_session_state,
    set_session_state_1,
    getall_session_channel,
    get_session_channel,
    get_channel_nb_sessions,
    getall_to_create,
    getall_orphaned,
    set_session_to_create,
    set_client_orphaned,
    set_server_session_preferred_locales,
    get_server_session_preferred_locales,
    set_server_session_client_app_desc,
    get_server_session_client_app_desc,
    set_server_session_client_cert_tb,
    get_server_session_client_cert_tb,
    set_server_session_name,
    get_server_session_name,
    reset_server_session_roles,
    reset_server_session_preferred_locales,
    reset_server_client_create_session_info,
    set_server_session_user_auth_attempts,
    get_server_session_user_auth_attempts,
    reset_server_session_user_auth_attempts,
    get_init_time,
    get_card_s_session

INVARIANT
    s_client_session = a_client_session~[{TRUE}] &
    a_client_session~[{TRUE}] <: dom(a_state) &
    card_s_session   = card(a_state)

OPERATIONS

    add_session(p_session, p_is_client, p_timeref) =
    BEGIN
        increase_card_s_session;
        set_session_state_1 (p_session, e_session_init);
        set_client_session(p_session, p_is_client);
        set_init_time (p_session, p_timeref);
        set_server_session_preferred_locales (p_session, c_LocaleIds_empty)
    END
    ;

    remove_session(p_session) =
    BEGIN
        decrease_card_s_session;
        reset_session_state(p_session);
        set_client_session(p_session, FALSE);
        reset_init_time(p_session)
    END
    ;

    reset_session_channel(p_session) =
    VAR
        l_dom,
        l_channel
    IN
        l_dom, l_channel <-- getall_session_channel(p_session);
        IF l_dom = TRUE
        THEN
            decrease_channel_nb_sessions(l_channel)
        END
        ;
        reset_channel (p_session)
    END
    ;

    set_session_channel (session, p_channel) =
    VAR
        l_dom,
        l_prev_channel
    IN
        l_dom, l_prev_channel <-- getall_session_channel(session);
        IF l_dom = TRUE
        THEN
            IF l_prev_channel /= p_channel
            THEN
                ASSERT session : dom(a_channel) & a_channel (session) /= p_channel THEN
                    decrease_channel_nb_sessions (l_prev_channel)
                END;
                increase_channel_nb_sessions (p_channel)
            ELSE
                ASSERT session : dom(a_channel) & a_channel(session) = p_channel THEN
                    skip
                END
            END
        ELSE
             increase_channel_nb_sessions (p_channel)
        END
        ;
        set_channel (session, p_channel)
    END

END
